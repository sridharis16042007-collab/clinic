# ==============================================================================
# CLINIC WEBSITE & ADMIN DASHBOARD ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Public API (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (SERVER ONLY - NEVER expose to client)
# Used for admin tasks, revalidation, and bypass of RLS for server-side exports
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication Allowlist
# Comma-separated list of approved emails permitted to access /admin
ADMIN_ALLOWED_EMAILS=admin@vrikshamclinic.in,doctor@vrikshamclinic.in

# Public Production URL (used for canonical URLs, Open Graph, and sitemaps)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret token to protect on-demand cache revalidation endpoint (/api/revalidate)
REVALIDATE_SECRET_TOKEN=your-custom-secure-random-token-here

# Default clinic accent color fallback (if database is connecting)
NEXT_PUBLIC_DEFAULT_ACCENT_COLOR=#2f8f4e
